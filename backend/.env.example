# Multi-Tenant SaaS CRM Environment Configuration Template
PORT=5000
NODE_ENV=production
DATABASE_URL=postgresql://crm_user:SecurePassword123!@postgres:5432/crm_db?schema=public
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
STORAGE_PATH=uploads

# JWT Security Secrets
JWT_SECRET=production_super_secret_access_token_jwt_key_998877665544332211
